{
  "manifest_version": 2,
  "name": "Manga Türkçe Overlay (Demo)",
  "version": "0.5.3",
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'self';",
  "description": "Yerel OCR ve DeepL ile İngilizce manga metinlerini Türkçe overlay olarak gösterir.",
  "browser_action": { "default_popup": "popup.html" },
  "background": { "scripts": ["background.js"], "persistent": false },
  "permissions": ["activeTab", "storage", "webRequest", "webRequestBlocking", "<all_urls>"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": ["ocr.js", "ocr-frame.js", "ocr-frame.html", "ocr-worker.min.js", "ocr-core/*", "ocr-lang/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "manga-turkce-overlay@example.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent"]
      }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}

